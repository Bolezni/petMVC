# Шаблон окружения. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
#
# Генерация секретов:
#   JWT_SECRET (base64, минимум 32 байта):  openssl rand -base64 32
#   ADMIN_KEY (hex):                        openssl rand -hex 24

# --- База данных ---
DB_URL=jdbc:postgresql://db:5432/petProject
DB_NAME=petProject
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
# ВНИМАНИЕ: смена JWT_SECRET разлогинивает всех пользователей.
JWT_SECRET=change-me-base64-32-bytes
# 12 часов: столько живёт сессия в браузере без повторного входа
JWT_ACCESS_TTL_MS=43200000
# 30 дней: срок refresh-токена для API-клиентов
JWT_REFRESH_TTL_MS=2592000000

# --- Админ ---
# Ключ для POST /api/v1/admin/specialists (заголовок X-Admin-Key).
# Пустое значение = создание специалистов через API отключено.
ADMIN_KEY=change-me

# --- Файлы ---
STORAGE_PATH=./uploads

# --- Домен для Caddy (автоматический HTTPS) ---
DOMAIN=example.com

# --- Прочее ---
SQL_DEBUG=false
SECURITY_LOG_LEVEL=INFO
# true на сервере, false при локальной правке шаблонов
THYMELEAF_CACHE=true
